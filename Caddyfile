# =============================================================================
# WaterPulse Canada — Caddy v2 Reverse Proxy Configuration
# =============================================================================
#
# Routes all browser traffic through a single origin, enabling HTTPOnly cookie
# auth between the Next.js frontend and FastAPI backend (same-origin requirement).
#
# Routing rules (evaluated top-down, first matching `handle` wins):
#   /tiles/*      → static files in /srv/tiles    Self-hosted PMTiles basemap
#   /api/*        → backend:8000                  FastAPI REST endpoints
#   /docs         → backend:8000                  Swagger UI
#   /docs/*       → backend:8000                  Swagger sub-resources
#   /openapi.json → backend:8000                  OpenAPI spec
#   /*            → frontend:3000                 Next.js pages and static assets
#
# SITE_ADDRESS controls dev vs prod TLS behaviour:
#   Dev  (.env):  SITE_ADDRESS=:80              — plain HTTP, no TLS attempted
#   Prod (.env):  SITE_ADDRESS=waterpulse.ca    — automatic Let's Encrypt via ACME
#
# ACME_EMAIL is used by Let's Encrypt for cert expiry notices (prod only;
# ignored when SITE_ADDRESS=:80).
#
# The 30-minute read/write timeout on the backend matches the k8s ingress
# config so long-running admin sync endpoints don't hit a 504.
# =============================================================================

{
    # Default keeps the config valid when ACME_EMAIL is unset (dev / :80,
    # where ACME is never triggered). Prod sets ACME_EMAIL in .env.
    email {$ACME_EMAIL:dev@localhost}
}

{$SITE_ADDRESS} {
    encode zstd gzip

    # Baseline security headers for every response (frontend, API, tiles).
    #   nosniff         — stop browsers MIME-sniffing JSON/tiles into HTML/JS
    #   Referrer-Policy — don't leak full URLs (share tokens!) cross-origin
    #   X-Frame-Options — no framing, blocks clickjacking
    #   -Server         — don't advertise the proxy software/version
    # A Content-Security-Policy is a tracked follow-up: MapLibre needs
    # worker-src/blob: and the tile hosts allow-listed, which needs testing.
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }

    # Self-hosted PMTiles basemap. Caddy's file_server supports HTTP Range
    # requests by default (required by the pmtiles JS protocol handler).
    # The tiles/ folder is bind-mounted read-only from the repo root.
    handle /tiles/* {
        root * /srv/tiles
        uri strip_prefix /tiles
        file_server
        header Cache-Control "public, max-age=86400"
        header Access-Control-Allow-Origin "*"
    }

    @backend path /api/* /docs /docs/* /openapi.json
    handle @backend {
        reverse_proxy backend:8000 {
            transport http {
                dial_timeout 30s
                read_timeout 30m
                write_timeout 30m
            }
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            # Overwrite (never append to) any client-sent X-Forwarded-For:
            # the backend trusts this header for per-client rate limiting.
            # {client_ip} is the TCP peer, or the real client once
            # trusted_proxies is configured (e.g. for a Cloudflare tunnel).
            header_up X-Forwarded-For {client_ip}
        }
    }

    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            # Overwrite (never append to) any client-sent X-Forwarded-For:
            # the backend trusts this header for per-client rate limiting.
            # {client_ip} is the TCP peer, or the real client once
            # trusted_proxies is configured (e.g. for a Cloudflare tunnel).
            header_up X-Forwarded-For {client_ip}
        }
    }
}
